{
	# Explicit self-signed files only (no public CA).
	auto_https off
}

:443 {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	handle /healthz {
		reverse_proxy crowsnest:7843
	}
	handle /nest {
		reverse_proxy crowsnest:7843
	}
	handle {
		reverse_proxy crowsnest:7843
	}
}

:80 {
	redir https://{host}{uri} permanent
}
