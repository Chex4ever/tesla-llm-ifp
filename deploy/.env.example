# Copy to deploy/.env and fill in secrets.
DOMAIN_ROOT=teslant.ru
ACME_EMAIL=admin@teslant.ru

# Admin bootstrap (fleet UI)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password

# Postgres
POSTGRES_USER=pirate
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pirate

# Redis
REDIS_PASSWORD=change-me-redis

# NATS
NATS_TOKEN=change-me-nats

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_AGENTS=agents

# Headscale
HEADSCALE_MAGICDNS_BASE=workers.teslant.ru
# From: ./scripts/init-headscale.sh
HEADSCALE_API_KEY=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Registry (distribution)
REGISTRY_HTTP_SECRET=change-me-registry-secret

# Open WebUI
WEBUI_SECRET_KEY=change-me-webui-secret
# Created after first fleet-api boot; set service API key for Open WebUI
OPENAI_API_KEY=sk-pirate-change-me

# Internal shared secret between gateway and fleet-api
INTERNAL_SHARED_SECRET=change-me-internal

# Public URLs (used in onboarding instructions)
PUBLIC_FLEET_URL=https://fleet.teslant.ru
PUBLIC_API_URL=https://api.teslant.ru
PUBLIC_HS_URL=https://hs.teslant.ru
# Host:port of VPS (agents dial this). Prefer DNS later: nats.teslant.ru:4222
PUBLIC_NATS_URL=nats://YOUR_VPS_IP:4222
