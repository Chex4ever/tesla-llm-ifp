fleet.{$DOMAIN_ROOT} {
	handle /api/* {
		reverse_proxy fleet-api:8081
	}
	handle /agent/* {
		reverse_proxy fleet-api:8081
	}
	handle {
		reverse_proxy fleet-ui:80
	}
}

api.{$DOMAIN_ROOT} {
	reverse_proxy gateway:8080
}

